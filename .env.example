# Acesso compartilhado da V1. Configure no Vercel e nunca commite os valores reais.
APP_ACCESS_USERNAME=almir
APP_ACCESS_PASSWORD=troque-por-uma-senha-forte

# Supabase público (frontend / SSR)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-only. Use a Secret Key (recomendado) ou service_role legado.
# Nunca use NEXT_PUBLIC_ neste valor.
SUPABASE_SECRET_KEY=
